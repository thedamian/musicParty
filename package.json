{
  "name": "music-party",
  "version": "1.0.0",
  "private": true,
  "description": "Party jukebox: guests search YouTube from their phones and queue songs; one phone on the big speaker plays them.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.1",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
