# Copy to .env and fill in. .env is git-ignored; never commit it.
# Every setting has a default, so the app also runs with no .env at all.

# --- Server ---------------------------------------------------------------------------------
PORT=5004
# 127.0.0.1 = only reachable through the reverse proxy (Caddy) on this machine.
HOST=127.0.0.1
# Shown on the speaker screen and in its QR code. Empty = taken from the request.
PUBLIC_URL=https://music.bocajs.org
# true when Caddy/nginx runs on this machine in front of Node (real client IPs, https cookies).
TRUST_PROXY=true
# Where the queue (queue.json) and play history (history.jsonl) are saved.
DATA_DIR=data

# --- YouTube search -------------------------------------------------------------------------
# YouTube Data API v3 key. Optional: without it (or once its daily quota is used up)
# search falls back to keyless YouTube search if SEARCH_FALLBACK=true.
YOUTUBE_API_KEY=
# Added to every search so mostly songs come up. Examples: "official audio", "lyrics", "audio".
# Leave empty to search exactly what guests type. Skipped if the guest already typed it.
SEARCH_SUFFIX=
# YouTube category to search in; 10 = Music. Empty = any category. (API only)
SEARCH_CATEGORY_ID=10
# Two-letter country code, so results are playable in your country.
SEARCH_REGION_CODE=US
# none | moderate | strict  (API only)
SEARCH_SAFE=moderate
# Results per search (1-50).
SEARCH_MAX_RESULTS=15
# Use keyless YouTube search when there's no API key or the quota is used up (true/false).
SEARCH_FALLBACK=true
# Reuse results for a repeated search for this long. Saves API quota.
SEARCH_CACHE_MINUTES=360
# Searches allowed per minute per IP address. 0 = unlimited.
SEARCH_PER_MINUTE=10

# --- Queue rules ----------------------------------------------------------------------------
# Hides videos shorter than this (YouTube Shorts, intros) from search results.
MIN_SONG_SECONDS=60
# Hides videos longer than this (hour-long mixes, full albums). 0 = no limit.
MAX_SONG_MINUTES=10
# Songs one guest may have waiting at once. 0 = unlimited.
MAX_SONGS_PER_GUEST=3
# Songs waiting in total. 0 = unlimited.
MAX_QUEUE=200
# Songs a guest (and an IP address) may add per minute. 0 = unlimited.
ADDS_PER_MINUTE=10
